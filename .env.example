# Application Configuration
NODE_ENV=development
PORT=3000

# Database Configuration (when implemented)
# DATABASE_URL=postgresql://username:password@localhost:5432/fresh_dev
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=fresh_dev
# DATABASE_USER=username
# DATABASE_PASSWORD=password

# API Keys (when needed)
# API_KEY=your_api_key_here
# JWT_SECRET=your_jwt_secret_here

# External Services (when implemented)
# REDIS_URL=redis://localhost:6379
# EMAIL_SERVICE_API_KEY=your_email_service_key

# Logging Configuration
LOG_LEVEL=debug

# Security Configuration
# SESSION_SECRET=your_session_secret_here
# CORS_ORIGIN=http://localhost:3000

# Feature Flags (when implemented)
# FEATURE_NEW_UI=true
# FEATURE_ANALYTICS=false
